@startuml
!NEW_C4_STYLE=1
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

'LAYOUT_LEFT_RIGHT()
LAYOUT_TOP_DOWN()

AddElementTag("mvp", $bgColor="black", $fontColor="lightGreen")
AddRelTag("async", $textColor=$ARROW_FONT_COLOR, $lineColor=$ARROW_COLOR, $lineStyle=DashedLine())
AddRelTag("mvp_rel", $lineColor="green")

title Container Diagram fot Bank Standart Online products (MVP)

Person_Ext(client, "Клиент", "")
System_Ext(credit_bureau, "Бюро кредитных историй")
System_Ext(cb_rf, "Центробанк")

Container_Boundary(bank, "Банк Стандарт") {
Container_Boundary(data_proc_center, "ЦОД") {
    Container(internet_bank, "Интернет-банк", "ASP.NET+MS SQL", "Монолит")
}
    Container(abs, "АБС", "Delphi+Oracle", "Логика на процедурах PL-SQL")
    Container(credit_system, "Кредитный конвейер", "Camunda\Java+Oracle", "")
    Container(scoring_system, "Кредитный скоринг", "Python+PostgreSql", "")

    BiRel(credit_system, abs, "Раз в сутки", $tags="async")
    Rel(scoring_system, abs, "Раз в сутки получает данные", $tags="async")
    Rel(credit_system, scoring_system, "Вызывает по API")
    Rel(scoring_system, credit_system, "Раз в сутки получает данные", $tags="async")

    Person(back_office, "Менеджеры бэк-офиса", "")
    Rel(back_office, abs, "Работает в")
    Rel(back_office, credit_system, "Работает в")

    Container("rate_microservice", "Микросервис Ставок", "PHP+PostgreSql", $tags="mvp")
    Container("leads_microservice", "Микросервис Лидов", "PHP+PostgreSql", $tags="mvp")

    Rel(internet_bank, "rate_microservice", "Читает ставки из", "HTTP", $tags="mvp_rel")

    Rel(internet_bank, "leads_microservice", "Отправляет лид", "HTTP", $tags="mvp_rel")
    Rel(rate_microservice, "scoring_system", "Предрассчитывает ставки", "", $tags="mvp_rel")
}

Rel(client, internet_bank, "Выбирает условия по депозиту, вводит код подтверждения", "", $tags="mvp_rel")

Rel(leads_microservice, client, "СМС с кодом подтверждения", $tags="mvp_rel")

Rel(scoring_system, credit_bureau, "Получает кред. рейтинг клиента")
Rel(rate_microservice, cb_rf, "Получает ключ. ставку", $tags="mvp_rel")

Rel(leads_microservice, abs, "Создает заявку на депозит", $tags="mvp_rel")

@enduml